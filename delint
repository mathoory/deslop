#!/usr/bin/env bash
# Lint prose for AI-writing tells: Vale (ai-tells + proselint + Claudisms), then the proselint CLI.
# Usage: delint <file or folder>...      Exit code 1 if anything was flagged.
set -u
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ $# -eq 0 ]; then echo "usage: delint <file or folder>..." >&2; exit 2; fi
if [ ! -d "$DIR/styles/ai-tells" ]; then vale --config "$DIR/.vale.ini" sync >/dev/null; fi
status=0
vale --config "$DIR/.vale.ini" --output line "$@" || status=1
if command -v proselint >/dev/null 2>&1; then
  PYTHONUTF8=1 proselint check --config "$DIR/proselintrc.json" -o compact "$@" || status=1
else
  echo "(proselint not installed: pip install proselint)" >&2
fi
exit $status
